VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
# Raw JWT anon key (eyJ...). Required by src/lib/newsletter.ts — the edge
# function call fails with sb_publishable_* keys used as raw Authorization headers.
VITE_SUPABASE_ANON_KEY="eyJ..."

# Google Analytics 4
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Mapbox (interactive map on Destinations page)
VITE_MAPBOX_TOKEN="pk.your_mapbox_public_token"

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# Resend (for email sending)
RESEND_API_KEY="re_your_api_key"
RESEND_AUDIENCE_ID="audience_id"

# Stripe (Payments)
# Use sk_test_* / whsec_* locally; Vercel scope=Production should hold sk_live_*.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Supabase (Server-side)
SUPABASE_SERVICE_ROLE_KEY="service_role_key"

# Discovery Agent (server-to-server auth for create-discovery-draft edge function)
AGENT_SECRET="your-agent-secret-here"
